table fact_lead
	lineageTag: bdf47b44-2fed-46b1-afd9-694eedc042b7

	measure Leads = COUNTROWS(fact_lead)
		formatString: #,0
		lineageTag: b13876c1-963a-49c7-a113-c3f0a276e1bf

	measure 'Lead Conversion %' = DIVIDE(CALCULATE(COUNTROWS(fact_lead), fact_lead[status] = "Won"), COUNTROWS(fact_lead))
