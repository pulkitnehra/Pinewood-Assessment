{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "barIncidentRate",
  "position": {
    "x": 640,
    "y": 130,
    "z": 0,
    "height": 280,
    "width": 630
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_community"
                    }
                  },
                  "Property": "community_id"
                }
              },
              "queryRef": "dim_community.community_id",
              "nativeQueryRef": "community_id",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_incident"
                    }
                  },
                  "Property": "Incident Rate per 100 Resident-Days"
                }
              },
              "queryRef": "fact_incident.Incident Rate per 100 Resident-Days",
              "nativeQueryRef": "Incident Rate per 100 Resident-Days"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}